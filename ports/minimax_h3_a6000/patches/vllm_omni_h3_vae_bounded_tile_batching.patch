+def _configure_video_vae_spatial_tile_batching(model: nn.Module) -> bool:
+    if not _env_enabled(MINIMAX_H3_A6000_VIDEO_VAE_SPATIAL_TILE_BATCHING_ENV):
+        return False
+    if not hasattr(model, "stack_tiling"):
+        raise RuntimeError(
+            "MINIMAX_H3_A6000_VIDEO_VAE_SPATIAL_TILE_BATCHING=1 was requested, "
+            "but the MiniMax-H3 video VAE remote model has no stack_tiling switch"
+        )
+    model.stack_tiling = True
+    return True
+
+
+def _configure_video_vae_bounded_tile_batching(model: nn.Module) -> int:
+    tile_batch_size = _env_nonnegative_int(MINIMAX_H3_A6000_VIDEO_VAE_TILE_BATCH_SIZE_ENV)
+    original = getattr(model, "_a6000_original_run_tile_tasks", None)
+    if callable(original):
+        model._run_tile_tasks = original
+        delattr(model, "_a6000_original_run_tile_tasks")
+    if tile_batch_size == 0:
+        if hasattr(model, "_a6000_video_vae_tile_batch_size"):
+            delattr(model, "_a6000_video_vae_tile_batch_size")
+        return 0
+    if not hasattr(model, "stack_tiling"):
+        raise RuntimeError(
+            "MINIMAX_H3_A6000_VIDEO_VAE_TILE_BATCH_SIZE was requested, "
+            "but the MiniMax-H3 video VAE remote model has no stack_tiling switch"
+        )
+    original_run_tile_tasks = getattr(model, "_run_tile_tasks", None)
+    if not callable(original_run_tile_tasks):
+        raise RuntimeError(
+            "MINIMAX_H3_A6000_VIDEO_VAE_TILE_BATCH_SIZE was requested, "
+            "but the MiniMax-H3 video VAE remote model has no callable _run_tile_tasks"
+        )
+
+    def run_tile_tasks(tiles, tile_indices, forward_fn, stack_tiling, cls_agg=None):
+        if not stack_tiling or len(tile_indices) <= tile_batch_size:
+            return original_run_tile_tasks(tiles, tile_indices, forward_fn, stack_tiling, cls_agg)
+        outputs = []
+        for start in range(0, len(tile_indices), tile_batch_size):
+            chunk_indices = tile_indices[start : start + tile_batch_size]
+            outputs.extend(original_run_tile_tasks(tiles, chunk_indices, forward_fn, True, cls_agg))
+        return outputs
+
+    model.stack_tiling = True
+    model._a6000_original_run_tile_tasks = original_run_tile_tasks
+    model._run_tile_tasks = run_tile_tasks
+    model._a6000_video_vae_tile_batch_size = tile_batch_size
+    return tile_batch_size
