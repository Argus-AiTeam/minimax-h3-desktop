+def _env_enabled(name: str) -> bool:
+    return str(os.environ.get(name, "0")).strip().lower() in {"1", "true", "yes", "on"}
+
+
+def _env_nonnegative_int(name: str) -> int:
+    raw = str(os.environ.get(name, "0")).strip()
+    try:
+        value = int(raw)
+    except ValueError as exc:
+        raise RuntimeError(f"{name} must be a non-negative integer, got {raw!r}") from exc
+    if value < 0:
+        raise RuntimeError(f"{name} must be a non-negative integer, got {raw!r}")
+    return value
+
