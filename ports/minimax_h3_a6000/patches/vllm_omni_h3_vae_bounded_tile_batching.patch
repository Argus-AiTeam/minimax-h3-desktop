+class _A6000GraphSafeNormalize:
+    """Normalize-compatible callable with long-lived device constants.
+
+    torchvision.transforms.Normalize materializes mean/std inside forward with
+    torch.as_tensor(..., device=tensor.device).  That is exact eager behavior,
+    but it performs a host-to-device copy when tensor is CUDA and therefore is
+    not CUDA-Graph capturable.  This opt-in replacement preloads the same
+    constants on the target CUDA device for the dtypes used by the video VAE.
+    """
+
+    def __init__(self, source: Any, *, device: torch.device) -> None:
+        if device.type != "cuda":
+            raise RuntimeError(
+                "MINIMAX_H3_A6000_VIDEO_VAE_GRAPH_SAFE_REVERT=1 requires a CUDA target device"
+            )
+        mean = getattr(source, "mean", None)
+        std = getattr(source, "std", None)
+        if mean is None or std is None:
+            raise RuntimeError("processor.transform_rev does not expose Normalize mean/std")
+        self.mean = tuple(float(x) for x in mean)
+        self.std = tuple(float(x) for x in std)
+        if len(self.mean) != len(self.std):
+            raise RuntimeError("processor.transform_rev mean/std channel counts differ")
+        self.inplace = bool(getattr(source, "inplace", False))
+        self.device = torch.device(device)
+        self._constants = {
+            dtype: (
+                torch.tensor(self.mean, device=self.device, dtype=dtype).view(-1, 1, 1),
+                torch.tensor(self.std, device=self.device, dtype=dtype).view(-1, 1, 1),
+            )
+            for dtype in _GRAPH_SAFE_NORMALIZE_DTYPES
+        }
+
+    def __call__(self, tensor: torch.Tensor) -> torch.Tensor:
+        if tensor.device != self.device:
+            raise RuntimeError(
+                "graph-safe VAE revert Normalize expected tensor on "
+                f"{self.device}, got {tensor.device}"
+            )
+        constants = self._constants.get(tensor.dtype)
+        if constants is None:
+            raise RuntimeError(f"unsupported graph-safe VAE revert Normalize dtype {tensor.dtype}")
+        mean, std = constants
+        output = tensor if self.inplace else tensor.clone()
+        output.sub_(mean).div_(std)
+        return output
+
+
+def _configure_video_vae_graph_safe_revert(model: nn.Module, device: torch.device) -> bool:
+    if not _env_enabled(MINIMAX_H3_A6000_VIDEO_VAE_GRAPH_SAFE_REVERT_ENV):
+        return False
+    processor = getattr(model, "processor", None)
+    if processor is None or not hasattr(processor, "transform_rev"):
+        raise RuntimeError(
+            "MINIMAX_H3_A6000_VIDEO_VAE_GRAPH_SAFE_REVERT=1 was requested, "
+            "but the MiniMax-H3 video VAE model has no processor.transform_rev"
+        )
+    transform_rev = processor.transform_rev
+    if isinstance(transform_rev, _A6000GraphSafeNormalize):
+        return True
+    original = getattr(processor, "_a6000_original_transform_rev", transform_rev)
+    processor._a6000_original_transform_rev = original
+    processor.transform_rev = _A6000GraphSafeNormalize(original, device=torch.device(device))
+    return True
 
 
