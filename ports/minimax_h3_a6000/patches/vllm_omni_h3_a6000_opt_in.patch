+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Opt-in MiniMax-H3 A6000 Sol-Attn backend.
+
+This backend is fail-closed and default-off.  It accepts only the source-backed
+MiniMax-H3 packed-token metadata published by the vLLM-Omni H3 call path:
+``AttentionMetadata.video_layout`` for ``[prefix | video tail | padding]`` plus
+``extra.valid_kv_length``, ``extra.h3_denoise_step_index``, and
+``extra.h3_layer_index``.  If any field is absent or inconsistent, execution
+falls back to dense SDPA and telemetry records a stable blocker reason.  The
+Triton Sol-Attn candidate is reached only after explicit overlay/Sol-Attn env
+gates, cache-off policy, BF16 BSND shape checks, CUDA SM86 guard, and metadata
+validation all pass.
+"""
+
+from __future__ import annotations
+
+import atexit
+import json
+import os
+from dataclasses import dataclass, field
+from typing import Any, Mapping
+
+import torch
+
+from vllm_omni.diffusion.attention.backends.abstract import (
+    AttentionBackend,
+    AttentionImpl,
+    AttentionMetadata,
+)
+
+DEFAULT_ENV_SWITCHES = {
+    "MINIMAX_H3_A6000_ENABLE_OVERLAY": "0",
+    "MINIMAX_H3_A6000_ENABLE_TRITON_CANDIDATES": "0",
+    "MINIMAX_H3_A6000_ENABLE_SOL_ATTN": "0",
+    "MINIMAX_H3_A6000_ENABLE_TELEMETRY": "0",
+    "MINIMAX_H3_A6000_TELEMETRY_ATEXIT": "0",
+    "MINIMAX_H3_A6000_TELEMETRY_JSON": "",
+    "MINIMAX_H3_A6000_SOL_ATTN_CACHE": "0",
+    "MINIMAX_H3_A6000_SOL_ATTN_STRICT": "0",
+    "MINIMAX_H3_A6000_SOL_ATTN_DENSE_FIRST_STEPS": "10",
+    "MINIMAX_H3_A6000_SOL_ATTN_DENSE_FIRST_LAYERS": "2",
+    "MINIMAX_H3_A6000_SOL_ATTN_STRIDE_AWARE_V": "0",
+    "MINIMAX_H3_A6000_SOL_ATTN_DIAGNOSTIC_MATERIALIZE": "0",
+    "MINIMAX_H3_A6000_SOL_ATTN_MATERIALIZE_MAX_BYTES": "67108864",
+    "MINIMAX_H3_A6000_SOL_ATTN_TELEMETRY_JSON": "",
+    "MINIMAX_H3_A6000_SOL_ATTN_TELEMETRY_ARM_FILE": "",
+}
+
+MISSING_H3_HOOK_METADATA_PREFIX = "missing_h3_hook_metadata"
+
+
+def _env_enabled(name: str) -> bool:
+    return os.environ.get(name, DEFAULT_ENV_SWITCHES.get(name, "0")) == "1"
+
+
+def _strict_enabled() -> bool:
+    return _env_enabled("MINIMAX_H3_A6000_SOL_ATTN_STRICT")
+
+
+def _telemetry_armed() -> bool:
+    path = os.environ.get("MINIMAX_H3_A6000_SOL_ATTN_TELEMETRY_ARM_FILE", "").strip()
+    return not path or os.path.exists(path)
+
+
+@dataclass
+class H3A6000SolAttnTelemetry:
+    dense_calls: int = 0
+    sparse_candidate_calls: int = 0
+    sparse_calls: int = 0
+    fallback_calls: int = 0
+    prefix_query_dense_calls: int = 0
+    decline_reasons: dict[str, int] = field(default_factory=dict)
+    fallback_reasons: dict[str, int] = field(default_factory=dict)
+    sink_ranges: list[tuple[int, int]] = field(default_factory=list)
+    density_samples: list[dict[str, Any]] = field(default_factory=list)
+    layout_samples: list[dict[str, Any]] = field(default_factory=list)
+    materialize_copy_count: int = 0
+    materialize_copy_bytes: int = 0
+    materialize_copy_by_tensor: dict[str, int] = field(default_factory=dict)
+    materialize_latency_ms: float = 0.0
+    materialize_gpu_copy_latency_ms: float = 0.0
+    materialize_gpu_timing_failures: int = 0
+    stride_aware_value_calls: int = 0
+    stride_aware_value_bytes: int = 0
+    sparse_attention_gpu_latency_ms: float = 0.0
+    sparse_attention_timed_calls: int = 0
+    sparse_attention_gpu_timing_failures: int = 0
+    denoise_gpu_latency_ms: float = 0.0
+    denoise_timed_calls: int = 0
+    denoise_gpu_timing_failures: int = 0
+    _materialize_gpu_event_pairs: list[tuple[Any, Any]] = field(default_factory=list, repr=False)
+    _sparse_attention_gpu_event_pairs: list[tuple[Any, Any]] = field(default_factory=list, repr=False)
+    _denoise_gpu_event_pairs: list[tuple[Any, Any]] = field(default_factory=list, repr=False)
+
+    def decline(self, reason: str) -> None:
+        if not _telemetry_armed():
+            return
+        self.dense_calls += 1
+        self.decline_reasons[reason] = self.decline_reasons.get(reason, 0) + 1
+
+    def fallback(self, reason: str) -> None:
+        if not _telemetry_armed():
+            return
+        self.fallback_calls += 1
+        self.fallback_reasons[reason] = self.fallback_reasons.get(reason, 0) + 1
+        self.decline(reason)
+
+    def merge_wrapper(self, wrapper_telemetry: Any) -> None:
+        if not _telemetry_armed():
+            return
+        self.dense_calls += int(getattr(wrapper_telemetry, "dense_calls", 0))
+        self.sparse_candidate_calls += int(getattr(wrapper_telemetry, "sparse_candidate_calls", 0))
+        self.sparse_calls += int(getattr(wrapper_telemetry, "sparse_calls", 0))
+        self.fallback_calls += int(getattr(wrapper_telemetry, "fallback_calls", 0))
+        self.prefix_query_dense_calls += int(getattr(wrapper_telemetry, "prefix_query_dense_calls", 0))
+        for name, count in getattr(wrapper_telemetry, "decline_reasons", {}).items():
+            self.decline_reasons[str(name)] = self.decline_reasons.get(str(name), 0) + int(count)
+        for name, count in getattr(wrapper_telemetry, "fallback_reasons", {}).items():
+            self.fallback_reasons[str(name)] = self.fallback_reasons.get(str(name), 0) + int(count)
+        self.sink_ranges.extend(list(getattr(wrapper_telemetry, "sink_ranges", [])))
+        self.density_samples.extend(list(getattr(wrapper_telemetry, "density_samples", [])))
+        self.layout_samples.extend(list(getattr(wrapper_telemetry, "layout_samples", [])))
+        self.materialize_copy_count += int(getattr(wrapper_telemetry, "materialize_copy_count", 0))
+        self.materialize_copy_bytes += int(getattr(wrapper_telemetry, "materialize_copy_bytes", 0))
+        self.materialize_latency_ms += float(getattr(wrapper_telemetry, "materialize_latency_ms", 0.0))
+        self.stride_aware_value_calls += int(getattr(wrapper_telemetry, "stride_aware_value_calls", 0))
+        self.stride_aware_value_bytes += int(getattr(wrapper_telemetry, "stride_aware_value_bytes", 0))
+        self._materialize_gpu_event_pairs.extend(
+            list(getattr(wrapper_telemetry, "_materialize_gpu_event_pairs", []))
+        )
+        getattr(wrapper_telemetry, "_materialize_gpu_event_pairs", []).clear()
+        for name, count in getattr(wrapper_telemetry, "materialize_copy_by_tensor", {}).items():
+            key = str(name)
+            self.materialize_copy_by_tensor[key] = self.materialize_copy_by_tensor.get(key, 0) + int(count)
+
+    def record_layout(self, *, stage: str, query: torch.Tensor, key: torch.Tensor, value: torch.Tensor) -> None:
+        if not _telemetry_armed() or len(self.layout_samples) >= 32:
+            return
+        self.layout_samples.append(
+            {
+                "stage": str(stage),
+                "tensors": [_tensor_layout("query", query), _tensor_layout("key", key), _tensor_layout("value", value)],
+            }
+        )
+
+    def record_sparse_attention_events(self, start: Any, end: Any) -> None:
+        if not _telemetry_armed():
+            return
+        self.sparse_attention_timed_calls += 1
+        self._sparse_attention_gpu_event_pairs.append((start, end))
+
+    def record_denoise_events(self, start: Any, end: Any) -> None:
+        if not _telemetry_armed():
+            return
+        self.denoise_timed_calls += 1
+        self._denoise_gpu_event_pairs.append((start, end))
+
+    @staticmethod
+    def _finalize_event_pairs(pairs: list[tuple[Any, Any]]) -> tuple[float, int]:
+        total_ms = 0.0
+        failures = 0
+        for start, end in pairs:
+            try:
+                end.synchronize()
+                total_ms += float(start.elapsed_time(end))
+            except Exception:  # noqa: BLE001 - telemetry must not break process exit
+                failures += 1
+        pairs.clear()
+        return total_ms, failures
+
+    def finalize_gpu_timing(self) -> None:
+        value, failures = self._finalize_event_pairs(self._materialize_gpu_event_pairs)
+        self.materialize_gpu_copy_latency_ms += value
+        self.materialize_gpu_timing_failures += failures
+        value, failures = self._finalize_event_pairs(self._sparse_attention_gpu_event_pairs)
+        self.sparse_attention_gpu_latency_ms += value
+        self.sparse_attention_gpu_timing_failures += failures
+        value, failures = self._finalize_event_pairs(self._denoise_gpu_event_pairs)
+        self.denoise_gpu_latency_ms += value
+        self.denoise_gpu_timing_failures += failures
+
+
+_TELEMETRY = H3A6000SolAttnTelemetry()
+
+
+def get_h3_a6000_sol_attn_telemetry() -> H3A6000SolAttnTelemetry:
+    return _TELEMETRY
+
+
+def record_h3_a6000_denoise_events(start: Any, end: Any) -> None:
+    _TELEMETRY.record_denoise_events(start, end)
+
+
+def _sol_attn_telemetry_json() -> dict[str, Any]:
+    _TELEMETRY.finalize_gpu_timing()
+    return {
+        "schema_version": "minimax_h3_a6000_sol_attn_telemetry_v3",
+        "density_sample_kind": "static_exact_block_lower_bound",
+        "dense_calls": _TELEMETRY.dense_calls,
+        "sparse_candidate_calls": _TELEMETRY.sparse_candidate_calls,
+        "sparse_calls": _TELEMETRY.sparse_calls,
+        "fallback_calls": _TELEMETRY.fallback_calls,
+        "prefix_query_dense_calls": _TELEMETRY.prefix_query_dense_calls,
+        "decline_reasons": dict(_TELEMETRY.decline_reasons),
+        "fallback_reasons": dict(_TELEMETRY.fallback_reasons),
+        "sink_ranges": list(_TELEMETRY.sink_ranges),
+        "density_samples": list(_TELEMETRY.density_samples),
+        "layout_samples": list(_TELEMETRY.layout_samples),
+        "materialize_copy_count": _TELEMETRY.materialize_copy_count,
+        "materialize_copy_bytes": _TELEMETRY.materialize_copy_bytes,
+        "materialize_copy_by_tensor": dict(_TELEMETRY.materialize_copy_by_tensor),
+        "materialize_latency_ms": _TELEMETRY.materialize_latency_ms,
+        "materialize_host_enqueue_latency_ms": _TELEMETRY.materialize_latency_ms,
+        "materialize_gpu_copy_latency_ms": _TELEMETRY.materialize_gpu_copy_latency_ms,
+        "materialize_gpu_timing_failures": _TELEMETRY.materialize_gpu_timing_failures,
+        "input_copy_events": _TELEMETRY.materialize_copy_count,
+        "input_copy_bytes": _TELEMETRY.materialize_copy_bytes,
+        "input_copy_by_tensor": dict(_TELEMETRY.materialize_copy_by_tensor),
+        "stride_aware_value_calls": _TELEMETRY.stride_aware_value_calls,
+        "stride_aware_value_bytes": _TELEMETRY.stride_aware_value_bytes,
+        "sparse_attention_gpu_latency_ms": _TELEMETRY.sparse_attention_gpu_latency_ms,
+        "sparse_attention_timed_calls": _TELEMETRY.sparse_attention_timed_calls,
+        "sparse_attention_gpu_timing_failures": _TELEMETRY.sparse_attention_gpu_timing_failures,
+        "denoise_gpu_latency_ms": _TELEMETRY.denoise_gpu_latency_ms,
+        "denoise_timed_calls": _TELEMETRY.denoise_timed_calls,
+        "denoise_gpu_timing_failures": _TELEMETRY.denoise_gpu_timing_failures,
+    }
+
+
+def _tensor_layout(name: str, tensor: torch.Tensor) -> dict[str, Any]:
+    return {
+        "name": name,
+        "shape": [int(x) for x in tensor.shape],
+        "stride": [int(x) for x in tensor.stride()],
+        "storage_offset": int(tensor.storage_offset()),
+        "dtype": str(tensor.dtype).replace("torch.", ""),
+        "device_type": tensor.device.type,
+        "is_contiguous": bool(tensor.is_contiguous()),
+    }
+
+
+def _write_sol_attn_telemetry_at_exit() -> None:
+    path = os.environ.get("MINIMAX_H3_A6000_SOL_ATTN_TELEMETRY_JSON") or os.environ.get(
+        "MINIMAX_H3_A6000_TELEMETRY_JSON"
+    )
+    if path:
+        with open(path + ".sol_attn.json", "w", encoding="utf-8") as f:
+            json.dump(_sol_attn_telemetry_json(), f, indent=2, sort_keys=True)
+
+
+if _env_enabled("MINIMAX_H3_A6000_ENABLE_TELEMETRY") and _env_enabled("MINIMAX_H3_A6000_TELEMETRY_ATEXIT"):
+    atexit.register(_write_sol_attn_telemetry_at_exit)
+
+
+@dataclass(frozen=True)
+class _SolAttnSparseMetadata:
+    step_index: int
+    layer_index: int
+    prefix_len: int
+    latent_grid: tuple[int, int, int]
+    valid_length: int
+    total_length: int
+
+    @property
+    def video_rows(self) -> int:
+        t, h, w = self.latent_grid
+        return t * h * w
+
+
+def _field(source: Any, name: str) -> Any:
+    if isinstance(source, Mapping):
+        return source.get(name)
+    return getattr(source, name, None)
+
+
+def _metadata_extra(attn_metadata: AttentionMetadata | None) -> Mapping[str, Any]:
+    extra = _field(attn_metadata, "extra") if attn_metadata is not None else None
+    return extra if isinstance(extra, Mapping) else {}
+
+
+def _read_int(source: Mapping[str, Any] | Any, *names: str) -> int | None:
+    for name in names:
+        value = _field(source, name)
+        if value is None:
+            continue
+        try:
+            return int(value)
+        except (TypeError, ValueError):
+            return None
+    return None
+
+
+def _read_env_int(name: str, default: int) -> int:
+    try:
+        return int(str(os.environ.get(name, DEFAULT_ENV_SWITCHES.get(name, str(default)))).strip())
+    except (TypeError, ValueError):
+        return int(default)
+
+
+def _is_minimax_h3_dit_attention_prefix(prefix: str) -> bool:
+    parts = str(prefix).split(".")
+    return len(parts) >= 3 and parts[0] == "blocks" and parts[1].isdigit() and parts[2] == "attn"
+
+
+def _missing_hook_reason(detail: str) -> str:
+    return f"{MISSING_H3_HOOK_METADATA_PREFIX}:{detail}"
+
+
+def _extract_sparse_metadata(
+    attn_metadata: AttentionMetadata | None,
+    total_length: int,
+) -> tuple[_SolAttnSparseMetadata | None, str | None]:
+    if int(total_length) <= 0:
+        return None, _missing_hook_reason("invalid_total_length")
+    if attn_metadata is None:
+        return None, _missing_hook_reason("missing_attention_metadata")
+    layout = getattr(attn_metadata, "video_layout", None)
+    if layout is None:
+        return None, _missing_hook_reason("missing_packed_video_layout")
+    prefix_len = _read_int(layout, "prefix_len")
+    latent_grid_raw = _field(layout, "latent_grid")
+    if prefix_len is None or latent_grid_raw is None:
+        return None, _missing_hook_reason("invalid_packed_video_layout")
+    try:
+        latent_grid = tuple(int(x) for x in latent_grid_raw)
+    except (TypeError, ValueError):
+        return None, _missing_hook_reason("invalid_packed_video_layout")
+    if len(latent_grid) != 3 or any(x <= 0 for x in latent_grid):
+        return None, _missing_hook_reason("invalid_packed_video_layout")
+
+    extra = _metadata_extra(attn_metadata)
+    valid = _read_int(extra, "h3_valid_kv_length", "valid_kv_length")
+    if valid is None:
+        return None, _missing_hook_reason("missing_valid_kv_length_metadata")
+    step_index = _read_int(extra, "h3_denoise_step_index", "denoise_step_index", "step_index")
+    layer_index = _read_int(extra, "h3_layer_index", "layer_index")
+    if step_index is None or layer_index is None:
+        return None, _missing_hook_reason("missing_step_layer_metadata")
+    if step_index < 0 or layer_index < 0:
+        return None, _missing_hook_reason("invalid_step_layer_metadata")
+
+    video_rows = latent_grid[0] * latent_grid[1] * latent_grid[2]
+    if valid != prefix_len + video_rows or valid <= 0 or valid > int(total_length):
+        return None, _missing_hook_reason("invalid_packed_video_layout")
+    return (
+        _SolAttnSparseMetadata(
+            step_index=step_index,
+            layer_index=layer_index,
+            prefix_len=prefix_len,
+            latent_grid=latent_grid,
+            valid_length=valid,
+            total_length=int(total_length),
+        ),
+        None,
+    )
+
+
+def _dense_sdpa_raw(
+    query: torch.Tensor,
+    key: torch.Tensor,
+    value: torch.Tensor,
+    scale: float,
+    attn_mask: torch.Tensor | None = None,
+) -> torch.Tensor:
+    q, k, v = (x.permute(0, 2, 1, 3) for x in (query, key, value))
+    out = torch.nn.functional.scaled_dot_product_attention(
+        q,
+        k,
+        v,
+        attn_mask=attn_mask,
+        dropout_p=0.0,
+        is_causal=False,
+        scale=scale,
+    )
+    return out.permute(0, 2, 1, 3).contiguous()
+
+
+def _valid_kv_length(attn_metadata: AttentionMetadata | None) -> int | None:
+    return _read_int(_metadata_extra(attn_metadata), "h3_valid_kv_length", "valid_kv_length")
+
+
+def _dense_sdpa(
+    query: torch.Tensor,
+    key: torch.Tensor,
+    value: torch.Tensor,
+    scale: float,
+    attn_metadata: AttentionMetadata | None,
+) -> torch.Tensor:
+    attn_mask = getattr(attn_metadata, "attn_mask", None)
+    valid = _valid_kv_length(attn_metadata)
+    if attn_mask is None and valid is not None and query.shape == key.shape == value.shape and 0 < valid <= key.shape[1]:
+        output = torch.zeros_like(value)
+        output[:, :valid] = _dense_sdpa_raw(query[:, :valid], key[:, :valid], value[:, :valid], scale)
+        return output
+    return _dense_sdpa_raw(query, key, value, scale, attn_mask=attn_mask)
+
+
+def _device_capability(query: torch.Tensor) -> tuple[int, int] | None:
+    if query.device.type != "cuda":
+        return None
+    try:
+        cap = torch.cuda.get_device_capability(query.device)
+    except Exception:
+        return None
+    return (int(cap[0]), int(cap[1]))
+
+
+def _sm86_guard(query: torch.Tensor) -> bool:
+    return _device_capability(query) == (8, 6)
+
+
+class SolAttnH3A6000Backend(AttentionBackend):
+    """vLLM-Omni backend class; opt-in sparse candidate with dense fallback."""
+
+    supports_prefix_kv_slicing = True
+    supported_platforms = ("cuda",)
+
+    @classmethod
+    def validate_available(cls) -> None:
+        # Backend selection itself is allowed on a disposable integration tree;
+        # all optional sparse dependencies are imported lazily by forward_cuda.
+        return None
+
+    @staticmethod
+    def get_name() -> str:
+        return "H3_A6000_SOL_ATTN"
+
+    @staticmethod
+    def get_impl_cls() -> type["SolAttnH3A6000Impl"]:
+        return SolAttnH3A6000Impl
+
+    @staticmethod
+    def get_metadata_cls() -> type[AttentionMetadata]:
+        return AttentionMetadata
+
+    @staticmethod
+    def get_builder_cls() -> None:
+        return None
+
+    @staticmethod
+    def get_supported_head_sizes() -> list[int]:
+        return [128]
+
+
+class SolAttnH3A6000Impl(AttentionImpl[AttentionMetadata]):
+    def __init__(
+        self,
+        num_heads: int,
+        head_size: int,
+        softmax_scale: float,
+        causal: bool = False,
+        num_kv_heads: int | None = None,
+        prefix: str = "",
+        qkv_layout: str | None = None,
+        backend_kwargs: dict[str, Any] | None = None,
+        **extra_impl_args: Any,
+    ) -> None:
+        del num_heads, num_kv_heads, backend_kwargs
+        if causal:
+            raise ValueError("MiniMax-H3 Sol-Attn expects non-causal self attention")
+        if head_size != 128:
+            raise ValueError(f"MiniMax-H3 Sol-Attn supports head_size=128, got {head_size}")
+        if qkv_layout not in (None, "BSND"):
+            raise ValueError(f"MiniMax-H3 Sol-Attn expects BSND qkv layout, got {qkv_layout!r}")
+        self.softmax_scale = float(softmax_scale)
+        self.prefix = prefix
+        self.role = str(extra_impl_args.get("role", ""))
+        self._is_minimax_h3_dit_attention = _is_minimax_h3_dit_attention_prefix(prefix)
+        self.dense_first_steps = _read_env_int("MINIMAX_H3_A6000_SOL_ATTN_DENSE_FIRST_STEPS", 10)
+        self.dense_first_layers = _read_env_int("MINIMAX_H3_A6000_SOL_ATTN_DENSE_FIRST_LAYERS", 2)
+
+    def _decline_reason(
+        self,
+        query: torch.Tensor,
+        key: torch.Tensor,
+        value: torch.Tensor,
+        attn_metadata: AttentionMetadata | None,
+    ) -> str | None:
+        if not (
