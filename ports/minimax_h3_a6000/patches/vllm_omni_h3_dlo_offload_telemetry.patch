+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Default-off offload telemetry for MiniMax-H3 A6000 profiling.
+
+The telemetry is enabled only when ``MINIMAX_H3_A6000_DLO_TELEMETRY`` is true
+and ``MINIMAX_H3_A6000_DLO_TELEMETRY_JSON`` points at an evidence-local JSON
+file.  It records timings, byte counts, stream-event waits, and sanitized
+module/layer labels; it never serializes tensors, parameter values, checkpoint
+paths, prompts, media, or raw logs.
+"""
+
+from __future__ import annotations
+
+import atexit
+import json
+import math
+import os
+import statistics
+import threading
+import time
+from collections.abc import Mapping
+from pathlib import Path
+from typing import Any
+
+import torch
+
+_TRUE_VALUES = {"1", "true", "yes", "on"}
+
+
+def _env_flag(name: str, default: bool = False) -> bool:
+    raw = os.environ.get(name)
+    if raw is None:
+        return default
+    return raw.strip().lower() in _TRUE_VALUES
+
+
+def _finite_float(value: Any) -> float | None:
+    if isinstance(value, bool):
+        return None
+    if isinstance(value, (int, float)):
+        out = float(value)
+        return out if math.isfinite(out) else None
+    return None
+
+
+def _stats(values: list[float]) -> dict[str, Any]:
+    finite = [float(v) for v in values if math.isfinite(float(v))]
+    if not finite:
+        return {"n": 0, "status": "missing"}
+    out: dict[str, Any] = {
+        "n": len(finite),
+        "status": "measured",
+        "min": min(finite),
+        "max": max(finite),
+        "mean": statistics.mean(finite),
+        "median": statistics.median(finite),
+    }
+    if len(finite) > 1:
+        out["sample_std"] = statistics.stdev(finite)
+        out["cv_percent"] = out["sample_std"] / out["mean"] * 100.0 if abs(out["mean"]) > 1e-12 else None
+    else:
+        out["sample_std"] = 0.0
+        out["cv_percent"] = 0.0
+    return out
+
+
+def _tensor_bytes(tensor: torch.Tensor) -> int:
+    try:
+        return int(tensor.numel() * tensor.element_size())
+    except Exception:
+        return 0
+
+
+def cpu_shard_bytes(cpu_shards: Mapping[torch.dtype, torch.Tensor]) -> int:
+    return int(sum(_tensor_bytes(tensor) for tensor in cpu_shards.values()))
+
+
+def _make_timing_event(device: torch.device | None = None) -> torch.cuda.Event | None:
+    try:
+        if device is not None and device.type != "cuda":
+            return None
+        if not torch.cuda.is_available():
+            return None
+        return torch.cuda.Event(enable_timing=True)
+    except Exception:
+        return None
+
+
+def _record_event(event: torch.cuda.Event | None, stream: Any | None = None) -> None:
+    if event is None:
+        return
+    try:
+        if stream is None:
+            event.record()
+        else:
+            event.record(stream)
+    except Exception:
+        return
+
+
+def _elapsed_ms(start: torch.cuda.Event | None, end: torch.cuda.Event | None) -> float | None:
+    if start is None or end is None:
+        return None
+    try:
+        value = float(start.elapsed_time(end))
+        return value if math.isfinite(value) else None
+    except Exception:
+        return None
+
+
+def sanitized_hook_label(hook: Any) -> dict[str, Any]:
+    """Return only topology labels, never tensor names or checkpoint paths."""
+    return {
+        "backend": str(getattr(hook, "_dlo_telemetry_backend", hook.__class__.__name__)),
+        "module": str(getattr(hook, "_dlo_telemetry_module", "unknown")),
+        "group_id": int(getattr(hook, "_group_id", -1)) if isinstance(getattr(hook, "_group_id", -1), int) else -1,
+        "current_block_index": getattr(hook, "_dlo_telemetry_current_block_index", None),
+        "next_block_index": getattr(hook, "_dlo_telemetry_next_block_index", None),
+    }
+
+
+class OffloadTelemetry:
+    def __init__(self) -> None:
+        self.enabled = _env_flag("MINIMAX_H3_A6000_DLO_TELEMETRY", False)
+        self.output_path = os.environ.get("MINIMAX_H3_A6000_DLO_TELEMETRY_JSON") or ""
+        if not self.output_path:
+            self.enabled = False
+        self._lock = threading.Lock()
+        self._next_id = 1
+        self.prefetches: list[dict[str, Any]] = []
+        self.waits: list[dict[str, Any]] = []
+        self.offloads: list[dict[str, Any]] = []
+        self.group_first_events: list[dict[str, Any]] = []
+        self.lifecycle_events: list[dict[str, Any]] = []
+        self.created_utc = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+        if self.enabled:
+            atexit.register(self.dump)
+
+    def _alloc_id(self) -> int:
+        with self._lock:
+            value = self._next_id
+            self._next_id += 1
+        return value
+
+    def begin_prefetch(
+        self,
+        *,
+        hook: Any,
+        slot: int | None,
+        reason: str,
+        non_blocking: bool,
+        h2d_bytes: int,
+        allgather_output_bytes: int = 0,
+    ) -> dict[str, Any] | None:
+        if not self.enabled:
+            return None
+        device = getattr(hook, "device", None)
+        rec: dict[str, Any] = {
+            "id": self._alloc_id(),
+            "slot": slot,
+            "reason": str(reason),
+            "non_blocking": bool(non_blocking),
+            "h2d_bytes": int(h2d_bytes),
+            "allgather_output_bytes": int(allgather_output_bytes),
+            "host_started_perf_counter": time.perf_counter(),
+            **sanitized_hook_label(hook),
+            "_device_start_event": _make_timing_event(device),
+            "_device_end_event": _make_timing_event(device),
+        }
+        return rec
+
+    def record_prefetch_start(self, rec: dict[str, Any] | None, stream: Any | None) -> None:
+        if rec is not None:
+            _record_event(rec.get("_device_start_event"), stream)
+
+    def finish_prefetch(
+        self,
+        rec: dict[str, Any] | None,
+        *,
+        stream: Any | None,
+        host_enqueue_ms: float,
+        repoint_host_ms: float,
+    ) -> int | None:
+        if rec is None:
+            return None
+        _record_event(rec.get("_device_end_event"), stream)
+        rec["host_enqueue_ms"] = float(host_enqueue_ms)
+        rec["repoint_host_ms"] = float(repoint_host_ms)
+        rec["host_finished_perf_counter"] = time.perf_counter()
+        with self._lock:
+            self.prefetches.append(rec)
+        return int(rec["id"])
+
+    def record_wait_event(
+        self,
+        *,
+        hook: Any,
+        prefetch_id: int | None,
+        slot: int | None,
+        reason: str,
+        wait_callable,
+    ) -> None:
+        """Record compute-stream wait duration without adding a host synchronize."""
+        if not self.enabled:
+            wait_callable()
+            return
+        device = getattr(hook, "device", None)
+        start_event = _make_timing_event(device)
+        end_event = _make_timing_event(device)
+        try:
+            current_stream = torch.cuda.current_stream(device) if device is not None and device.type == "cuda" and torch.cuda.is_available() else None
+        except Exception:
+            current_stream = None
+        host_start = time.perf_counter()
+        _record_event(start_event, current_stream)
+        wait_callable()
+        _record_event(end_event, current_stream)
+        host_ms = (time.perf_counter() - host_start) * 1000.0
+        rec: dict[str, Any] = {
+            "id": self._alloc_id(),
+            "prefetch_id": prefetch_id,
+            "slot": slot,
+            "reason": str(reason),
+            "host_enqueue_ms": host_ms,
+            **sanitized_hook_label(hook),
+            "_device_start_event": start_event,
+            "_device_end_event": end_event,
+        }
+        with self._lock:
+            self.waits.append(rec)
+
+    def record_offload_placeholders(self, *, hook: Any, reason: str, host_ms: float) -> None:
+        if not self.enabled:
+            return
+        rec = {
+            "id": self._alloc_id(),
+            "reason": str(reason),
+            "host_ms": float(host_ms),
+            **sanitized_hook_label(hook),
+        }
+        with self._lock:
+            self.offloads.append(rec)
+
+    def record_group_first(self, *, hook: Any, slot: int | None, contaminated: bool) -> None:
+        if not self.enabled:
+            return
+        rec = {
+            "id": self._alloc_id(),
+            "slot": slot,
+            "contaminated": bool(contaminated),
+            **sanitized_hook_label(hook),
+        }
+        with self._lock:
+            self.group_first_events.append(rec)
+
+    def record_lifecycle(self, *, event: str, host_ms: float, bytes_moved: int = 0, block_count: int | None = None) -> None:
+        if not self.enabled:
+            return
+        rec = {
+            "id": self._alloc_id(),
+            "event": str(event),
+            "host_ms": float(host_ms),
+            "bytes_moved": int(bytes_moved),
+            "block_count": block_count,
+        }
+        with self._lock:
+            self.lifecycle_events.append(rec)
+
+    def _finalize_records(self) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
+        prefetches: list[dict[str, Any]] = []
+        waits: list[dict[str, Any]] = []
+        with self._lock:
+            raw_prefetches = list(self.prefetches)
+            raw_waits = list(self.waits)
+        for rec in raw_prefetches:
+            out = {k: v for k, v in rec.items() if not k.startswith("_") and k not in {"host_started_perf_counter", "host_finished_perf_counter"}}
+            elapsed = _elapsed_ms(rec.get("_device_start_event"), rec.get("_device_end_event"))
+            if elapsed is not None:
+                out["h2d_device_ms"] = elapsed
+            prefetches.append(out)
+        for rec in raw_waits:
+            out = {k: v for k, v in rec.items() if not k.startswith("_")}
+            elapsed = _elapsed_ms(rec.get("_device_start_event"), rec.get("_device_end_event"))
+            if elapsed is not None:
+                out["wait_device_ms"] = elapsed
+            waits.append(out)
+        return prefetches, waits
+
+    @staticmethod
+    def _by_key_stats(records: list[dict[str, Any]], value_key: str, group_keys: tuple[str, ...]) -> dict[str, Any]:
+        grouped: dict[str, list[float]] = {}
+        for rec in records:
+            value = _finite_float(rec.get(value_key))
+            if value is None:
+                continue
+            parts = [str(rec.get(key, "unknown")) for key in group_keys]
+            grouped["|".join(parts)] = grouped.get("|".join(parts), []) + [value]
+        return {key: _stats(values) for key, values in sorted(grouped.items())}
+
+    def _memory_summary(self) -> dict[str, Any]:
+        if not torch.cuda.is_available():
+            return {"status": "not_available_no_cuda"}
+        try:
+            free, total = torch.cuda.mem_get_info()
+            return {
+                "status": "measured_at_dump_after_synchronize",
+                "max_memory_allocated_mib": torch.cuda.max_memory_allocated() / 1048576.0,
+                "max_memory_reserved_mib": torch.cuda.max_memory_reserved() / 1048576.0,
+                "free_memory_mib": free / 1048576.0,
+                "total_memory_mib": total / 1048576.0,
+            }
+        except Exception as exc:
+            return {"status": "error", "error_type": exc.__class__.__name__}
+
+    def summarize(self, prefetches: list[dict[str, Any]], waits: list[dict[str, Any]]) -> dict[str, Any]:
+        h2d_ms = [float(v) for rec in prefetches if (v := _finite_float(rec.get("h2d_device_ms"))) is not None]
+        wait_ms = [float(v) for rec in waits if (v := _finite_float(rec.get("wait_device_ms"))) is not None]
+        h2d_total_s = sum(h2d_ms) / 1000.0
+        wait_total_s = sum(wait_ms) / 1000.0
+        return {
+            "schema_version": "minimax_h3_a6000_dlo_offload_telemetry_summary_v1",
+            "enabled": self.enabled,
+            "created_utc": self.created_utc,
+            "prefetch_count": len(prefetches),
+            "wait_event_count": len(waits),
+            "offload_placeholder_count": len(self.offloads),
+            "group_first_event_count": len(self.group_first_events),
+            "group_first_contaminated_count": sum(1 for rec in self.group_first_events if rec.get("contaminated")),
+            "sync_prefetch_count": sum(1 for rec in prefetches if not rec.get("non_blocking")),
+            "async_prefetch_count": sum(1 for rec in prefetches if rec.get("non_blocking")),
+            "h2d_bytes_total": int(sum(int(rec.get("h2d_bytes") or 0) for rec in prefetches)),
+            "allgather_output_bytes_total": int(sum(int(rec.get("allgather_output_bytes") or 0) for rec in prefetches)),
+            "h2d_copy_device_seconds_total": h2d_total_s,
+            "wait_event_device_seconds_total": wait_total_s,
+            "estimated_copy_overlap_seconds": max(0.0, h2d_total_s - wait_total_s),
+            "h2d_copy_host_enqueue_seconds_total": sum(float(rec.get("host_enqueue_ms") or 0.0) for rec in prefetches) / 1000.0,
+            "repoint_host_seconds_total": sum(float(rec.get("repoint_host_ms") or 0.0) for rec in prefetches) / 1000.0,
+            "offload_placeholder_host_seconds_total": sum(float(rec.get("host_ms") or 0.0) for rec in self.offloads) / 1000.0,
+            "lifecycle_host_seconds_total": sum(float(rec.get("host_ms") or 0.0) for rec in self.lifecycle_events) / 1000.0,
+            "lifecycle_bytes_total": int(sum(int(rec.get("bytes_moved") or 0) for rec in self.lifecycle_events)),
+            "h2d_device_ms_stats": _stats(h2d_ms),
+            "wait_device_ms_stats": _stats(wait_ms),
+            "h2d_device_ms_by_reason": self._by_key_stats(prefetches, "h2d_device_ms", ("reason",)),
+            "wait_device_ms_by_reason": self._by_key_stats(waits, "wait_device_ms", ("reason",)),
+            "h2d_device_ms_by_module_layer": self._by_key_stats(prefetches, "h2d_device_ms", ("module", "next_block_index")),
+            "wait_device_ms_by_module_layer": self._by_key_stats(waits, "wait_device_ms", ("module", "next_block_index")),
+            "memory": self._memory_summary(),
+            "claim_boundary": "DLO/offload telemetry only: timings, byte counts, stream events, and sanitized layer labels; no raw tensors, weights, prompts, media, private paths, quality claim, or speedup claim.",
+        }
+
+    def dump(self) -> None:
+        if not self.enabled or not self.output_path:
+            return
+        with self._lock:
+            has_records = bool(
+                self.prefetches
+                or self.waits
+                or self.offloads
+                or self.group_first_events
+                or self.lifecycle_events
+            )
+        if not has_records:
+            # Server/orchestrator helper processes may import the offloader but
+            # never execute hooks.  Do not let such empty processes clobber the
+            # worker process's telemetry file at interpreter shutdown.
+            return
+        try:
+            if torch.cuda.is_available():
+                torch.cuda.synchronize()
+        except Exception:
+            pass
+        prefetches, waits = self._finalize_records()
+        with self._lock:
+            offloads = list(self.offloads)
+            group_first_events = list(self.group_first_events)
+            lifecycle_events = list(self.lifecycle_events)
+        payload = {
+            "schema_version": "minimax_h3_a6000_dlo_offload_telemetry_v1",
+            "summary": self.summarize(prefetches, waits),
+            "prefetches": prefetches,
+            "wait_events": waits,
+            "offload_placeholders": offloads,
+            "group_first_events": group_first_events,
+            "lifecycle_events": lifecycle_events,
+        }
+        path = Path(self.output_path)
+        path.parent.mkdir(parents=True, exist_ok=True)
+        tmp = path.with_suffix(path.suffix + ".tmp")
+        tmp.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+        tmp.replace(path)
+
+
+_TELEMETRY = OffloadTelemetry()
+
+
+def get_offload_telemetry() -> OffloadTelemetry:
+    return _TELEMETRY
