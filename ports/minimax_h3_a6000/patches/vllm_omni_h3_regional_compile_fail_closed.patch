 logger = init_logger(__name__)
 
+_REGIONAL_COMPILE_MODULES: list[nn.Module] = []
+_REGIONAL_COMPILE_ATEXIT_REGISTERED = False
+
+
+def _env_flag(name: str, default: bool = False) -> bool:
+    value = os.environ.get(name)
+    if value is None:
+        return default
+    return value.strip().lower() in {"1", "true", "yes", "on"}
+
+
+def _regional_compile_telemetry_record(module: nn.Module) -> dict[str, Any]:
+    return {
+        "module_name": getattr(module, "_regional_compile_name", None),
+        "module_class": getattr(module, "_regional_compile_class", module.__class__.__name__),
+        "status": getattr(module, "_regional_compile_status", "unknown"),
+        "dynamic": getattr(module, "_regional_compile_dynamic", None),
+        "fail_closed": getattr(module, "_regional_compile_fail_closed", None),
+        "runtime_fallback_count": getattr(module, "_regional_compile_runtime_fallback_count", 0),
+        "fallback_reason": getattr(module, "_regional_compile_fallback_reason", None),
+    }
+
+
+def _write_regional_compile_telemetry() -> None:
+    path = os.environ.get("VLLM_OMNI_REGIONAL_COMPILE_TELEMETRY_JSON")
+    if not path or not _REGIONAL_COMPILE_MODULES:
+        return
+    records = [_regional_compile_telemetry_record(module) for module in _REGIONAL_COMPILE_MODULES]
+    payload = {
+        "schema_version": "vllm_omni_regional_compile_telemetry_v1",
+        "module_count": len(records),
+        "runtime_fallback_count": sum(int(record.get("runtime_fallback_count") or 0) for record in records),
+        "fallback_modules": [record for record in records if int(record.get("runtime_fallback_count") or 0) > 0],
+        "modules": records,
+    }
+    try:
+        with open(path, "w", encoding="utf-8") as f:
+            json.dump(payload, f, indent=2, sort_keys=True)
+            f.write("\n")
+    except Exception as exc:  # noqa: BLE001 - best-effort shutdown telemetry only.
+        logger.warning("Regional compile telemetry write failed for %s: %s", path, exc)
+
+
+def _register_regional_compile_telemetry_writer() -> None:
+    global _REGIONAL_COMPILE_ATEXIT_REGISTERED
+    if _REGIONAL_COMPILE_ATEXIT_REGISTERED:
+        return
+    atexit.register(_write_regional_compile_telemetry)
+    _REGIONAL_COMPILE_ATEXIT_REGISTERED = True
+
+
+def _make_fail_closed_forward(
+    *,
+    name: str,
+    module: nn.Module,
+    original_forward: Any,
+    compiled_forward: Any,
+) -> Any:
+    def _fail_closed_forward(*args: Any, **kwargs: Any) -> Any:
+        try:
+            return compiled_forward(*args, **kwargs)
+        except Exception as exc:  # noqa: BLE001 - compile fallback must catch backend/runtime failures.
+            module._regional_compile_status = "runtime_fallback_to_eager"
+            module._regional_compile_runtime_fallback_count = int(
+                getattr(module, "_regional_compile_runtime_fallback_count", 0)
+            ) + 1
+            module._regional_compile_fallback_reason = repr(exc)
+            module.forward = original_forward
+            logger.warning(
+                "Regional compiled forward for %s failed at runtime; restored eager forward: %s",
+                name,
+                exc,
+            )
+            return original_forward(*args, **kwargs)
+
+    _fail_closed_forward._regional_compile_safe_wrapper = True  # type: ignore[attr-defined]
+    return _fail_closed_forward
+
 
 def _matches_repeated_block(
     name: str,
