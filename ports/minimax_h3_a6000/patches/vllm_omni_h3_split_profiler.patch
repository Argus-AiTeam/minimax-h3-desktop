+    def _record_a6000_profile_duration(self, key: str, value: float) -> None:
+        if not _minimax_h3_a6000_split_profile_enabled():
+            return
+        if not getattr(self, "enable_diffusion_pipeline_profiler", False):
+            return
+        durations = getattr(self, "_stage_durations", None)
+        lock = getattr(self, "_profiler_lock", None)
+        if not isinstance(durations, dict) or lock is None:
+            return
+        with lock:
+            durations[key] = float(durations.get(key, 0.0)) + float(value)
+
+    @contextmanager
+    def _a6000_profile_span(self, key: str, *, device_timed: bool = True):
+        if not _minimax_h3_a6000_split_profile_enabled():
+            yield
+            return
+        use_cuda = bool(
+            device_timed
+            and self.device.type == "cuda"
+            and torch.cuda.is_available()
+        )
+        start_event = end_event = None
+        if use_cuda:
+            torch.cuda.synchronize(self.device)
+            start_event = torch.cuda.Event(enable_timing=True)
+            end_event = torch.cuda.Event(enable_timing=True)
+            start_event.record()
+        start = time.perf_counter()
+        try:
+            yield
+        finally:
+            if use_cuda and start_event is not None and end_event is not None:
+                end_event.record()
+                torch.cuda.synchronize(self.device)
+                self._record_a6000_profile_duration(
+                    f"{key}.device",
+                    float(start_event.elapsed_time(end_event)) / 1000.0,
+                )
+            self._record_a6000_profile_duration(f"{key}.wall", time.perf_counter() - start)
+
