index bfc496bd..472e7ba7 100644
--- a/vllm_omni/diffusion/cache/cachedit/backend.py
+++ b/vllm_omni/diffusion/cache/cachedit/backend.py
@@ -6,6 +6,7 @@
 from __future__ import annotations
 
 from collections.abc import Callable
+import json
 from operator import attrgetter
 from typing import TYPE_CHECKING, Any, TypeAlias, cast
 
@@ -53,6 +54,88 @@ def _dit_module_names(pipeline: SupportsComponentDiscovery) -> tuple[str, ...]:
     return tuple(resolved_names)
 
 
+def _as_int(value: Any) -> int:
+    if isinstance(value, bool):
+        return int(value)
+    if isinstance(value, int):
+        return value
+    if isinstance(value, float):
+        return int(value)
+    return 0
+
+
+def _emit_machine_readable_cache_summary(stats: list[Any]) -> None:
+    """Emit stable counters in addition to Cache-DiT's human summary.
+
+    Cache-DiT 1.3.0's own ``summary(..., details=True)`` only logs cache-step
+    statistics when residual-diff details are populated.  Some MiniMax-H3 Turbo
+    requests therefore print install/context lines but no parseable reuse or
+    compute counts.  Keep the upstream human summary, but also serialize the
+    returned ``CacheStats`` fields into one bounded machine-readable line so the
+    benchmark gate can distinguish zero reuse from missing telemetry.
+    """
+
+    totals = {
+        "cached_steps": 0,
+        "executed_steps": 0,
+        "transformer_executed_steps": 0,
+        "pruned_steps": 0,
+        "pruned_blocks": 0,
+        "actual_blocks": 0,
+        "cfg_cached_steps": 0,
+        "cfg_pruned_steps": 0,
+        "cfg_pruned_blocks": 0,
+        "cfg_actual_blocks": 0,
+        "stats_objects": len(stats),
+        "stats_with_cache_fields": 0,
+    }
+    for item in stats:
+        has_cache_field = False
+        cached_steps = getattr(item, "cached_steps", None)
+        if cached_steps is not None:
+            has_cache_field = True
+        totals["cached_steps"] += _as_int(getattr(item, "accumulated_cached_steps", 0))
+        totals["executed_steps"] += _as_int(getattr(item, "accumulated_executed_steps", 0))
+        totals["transformer_executed_steps"] += _as_int(
+            getattr(item, "accumulated_transformer_executed_steps", 0)
+        )
+        for total_key, attr_name in (
+            ("pruned_steps", "pruned_steps"),
+            ("pruned_blocks", "pruned_blocks"),
+            ("actual_blocks", "actual_blocks"),
+            ("cfg_pruned_steps", "cfg_pruned_steps"),
+            ("cfg_pruned_blocks", "cfg_pruned_blocks"),
+            ("cfg_actual_blocks", "cfg_actual_blocks"),
+        ):
+            value = getattr(item, attr_name, None)
+            if value is not None:
+                has_cache_field = True
+            if isinstance(value, (list, tuple)):
+                totals[total_key] += sum(_as_int(v) for v in value)
+            else:
+                totals[total_key] += _as_int(value)
+        cfg_cached_steps = getattr(item, "cfg_cached_steps", None)
+        if cfg_cached_steps is not None:
+            has_cache_field = True
+        totals["cfg_cached_steps"] += _as_int(getattr(item, "cfg_accumulated_cached_steps", 0))
+        if has_cache_field:
+            totals["stats_with_cache_fields"] += 1
+
+    logger.info("Cache-DiT request summary json: %s", json.dumps(totals, sort_keys=True))
+    logger.info(
+        "Cache-DiT request summary: cached_steps=%d executed_steps=%d "
+        "transformer_executed_steps=%d pruned_steps=%d pruned_blocks=%d actual_blocks=%d "
+        "stats_with_cache_fields=%d",
+        totals["cached_steps"],
+        totals["executed_steps"],
+        totals["transformer_executed_steps"],
+        totals["pruned_steps"],
+        totals["pruned_blocks"],
+        totals["actual_blocks"],
+        totals["stats_with_cache_fields"],
+    )
+
+
 def cache_summary(pipeline: SupportsComponentDiscovery, details: bool = True) -> None:
     """Log Cache-DiT statistics for every transformer on the pipeline."""
 
@@ -60,7 +143,7 @@ def cache_summary(pipeline: SupportsComponentDiscovery, details: bool = True) ->
     for transformer in transformers:
         if not BlockAdapter.is_cached(transformer):
             continue
-        cache_dit.summary(transformer, details=details)
+        _emit_machine_readable_cache_summary(cache_dit.summary(transformer, details=details))
 
     if not transformers:
         logger.warning("CacheDiT summary failed; this pipeline has no defined transformer attribute")
